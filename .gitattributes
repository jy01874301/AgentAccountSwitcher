# 统一换行符，避免 Windows 上签出/提交时反复出现 LF/CRLF 警告
* text=auto

# Windows 脚本必须是 CRLF，否则双击运行时可能被截断解析
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 源码与文档统一 LF
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.spec text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# 二进制
*.exe binary
*.dll binary
*.pyd binary
*.7z binary
*.ico binary
